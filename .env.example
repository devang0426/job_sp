# ─────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. Never commit .env.local.
# Full notes on each service: context/env-reference.md
#
# Eight values, across four free-tier signups plus Anthropic.
# Nothing here has a hard dollar floor except Claude usage.
# ─────────────────────────────────────────────────────────────


# ── Auth ─────────────────────────────────────────────────────
# clerk.com -> API keys. Free tier.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key_here

# clerk.com -> Webhooks -> create an endpoint for
# user.created / user.updated / user.deleted, pointing at
# <your origin>/api/webhooks/clerk. Verified with svix.
#
# This will not fire in local development — there is no public
# URL. That is expected: requireUser() JIT-upserts on clerkId.
CLERK_WEBHOOK_SIGNING_SECRET=your_clerk_webhook_signing_secret

# ── AI ───────────────────────────────────────────────────────
# console.anthropic.com. Pay per token.
# Model is claude-sonnet-5, set in lib/ai/client.ts — not here.
# Budget ~$0.021 per job evaluated, so a 40-job scan is ~$0.85
# before prompt caching.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# aistudio.google.com. Free tier, then pay per token.
# Gemini 2.5 Flash is the default provider when this is set;
# Claude is the fallback when it is not, or when a Gemini call
# fails. At least ONE of the two keys must be present, or every
# structured AI call throws. See lib/ai/generate.ts.
GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_studio_api_key_here

# ── Database ─────────────────────────────────────────────────
# neon.tech. Free tier.
#
# TWO strings, and the difference matters. DATABASE_URL must be
# the POOLED one — its host contains "-pooler". DIRECT_URL is
# the direct connection, needed because Prisma migrations cannot
# run through PgBouncer.
#
# Getting this wrong surfaces as connection exhaustion when a
# scan fans out, which is the worst moment to debug it.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ── Background jobs ──────────────────────────────────────────
# trigger.dev. Free tier. The project ref goes in
# trigger.config.ts, not here.
#
# IMPORTANT: tasks run on trigger.dev's infrastructure, NOT on
# Vercel, so they do not inherit Vercel's environment. Set
# DATABASE_URL, DIRECT_URL, ANTHROPIC_API_KEY, and the source
# keys separately in the trigger.dev dashboard, or the route
# will trigger fine and the task will fail on a missing var.
TRIGGER_SECRET_KEY=your_trigger_secret_key_here


# ── Job sources ──────────────────────────────────────────────

# developer.adzuna.com — free, ~250 calls/month.
# The breadth source. Good India coverage, structured salary.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# 200 REQUESTS PER MONTH, TOTAL. Easy to half-burn debugging.
# Optional — the product works without it. Enable the dev
# response cache before testing against this.
RAPIDAPI_KEY=

# ATS boards (Greenhouse / Lever / Ashby) — no key needed.
# Public JSON endpoints, unmetered. These are the default
# source and the demo-day safety net. Companies and their
# board tokens live in config/portals.yml.

# Playwright scraper — no key needed. Runs as a trigger.dev
# task with the Playwright build extension.

# firecrawl.dev — scrape-and-extract, not a job aggregator.
# Optional. Check your plan's actual monthly credit ceiling
# against lib/sources/quota.ts's FIRECRAWL entry, which is a
# conservative placeholder.
FIRECRAWL_API_KEY=


# ── App ──────────────────────────────────────────────────────
# Set to the deployed origin in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ─────────────────────────────────────────────────────────────
# Deliberately NOT in this stack. Recorded so they are not
# re-added by reflex:
#
#   REDIS_URL / UPSTASH_*  — trigger.dev handles queueing,
#                            retries, and concurrency.
#   CRON_SECRET            — there are no cron routes.
#   BLOB_* / R2_* / SUPABASE_* — the CV PDF is parsed and
#                            discarded; only text is kept.
#   OPENAI_API_KEY         — one AI provider.
# ─────────────────────────────────────────────────────────────
